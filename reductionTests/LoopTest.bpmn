<?xml version="1.0" encoding="UTF-8"?>
<!-- origin at X=0.0 Y=0.0 -->
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:catcomp="http://www.fc.ul.pt/catcomp" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:ext="http://org.eclipse.bpmn2/ext" xmlns:riskabpmn="http://www.fc.ul.pt/riskabpmn" xmlns:xs="http://www.w3.org/2001/XMLSchema" id="Definitions_1" exporter="org.eclipse.bpmn2.modeler.core" exporterVersion="1.4.2.Final-v20171109-1930-B1" targetNamespace="http://org.eclipse.bpmn2/default/collaboration">
  <bpmn2:import importType="http://www.w3.org/2001/XMLSchema" location="../BPMN2xsd/riskabpmn.xsd" namespace="http://www.fc.ul.pt/riskabpmn"/>
  <bpmn2:import importType="http://www.w3.org/2001/XMLSchema" location="../BPMN2xsd/catcomp.xsd" namespace="http://www.fc.ul.pt/catcomp"/>
  <bpmn2:extension mustUnderstand="true" definition="riskabpmn:riskabpmn"/>
  <bpmn2:extension mustUnderstand="true" definition="catcomp:catcomp"/>
  <bpmn2:category id="Category_1" name="Category 1">
    <bpmn2:extensionElements>
      <riskabpmn:businessValue xsi:type="xs:anyType"/>
      <riskabpmn:reliabilityValue xsi:type="xs:anyType"/>
      <riskabpmn:calculatedRisk xsi:type="xs:anyType"/>
      <catcomp:categoryValueRef xsi:type="xs:anyType">rootCategory</catcomp:categoryValueRef>
    </bpmn2:extensionElements>
    <bpmn2:categoryValue id="CategoryValue_2" value="Loop"/>
  </bpmn2:category>
  <bpmn2:collaboration id="Collaboration_1" name="Default Collaboration">
    <bpmn2:participant id="Participant_1" name="Initiating Pool" processRef="Process_1"/>
    <bpmn2:participant id="Participant_2" name="Non-initiating Pool" processRef="Process_2"/>
    <bpmn2:participant id="Participant_3" name="Default Pool" processRef="Process_3">
      <bpmn2:extensionElements>
        <ext:style/>
      </bpmn2:extensionElements>
    </bpmn2:participant>
  </bpmn2:collaboration>
  <bpmn2:process id="Process_1" name="Initiating Process" definitionalCollaborationRef="Collaboration_1" isExecutable="false">
    <bpmn2:extensionElements>
      <riskabpmn:businessValue xsi:type="xs:anyType">700</riskabpmn:businessValue>
      <riskabpmn:reliabilityValue xsi:type="xs:anyType"/>
      <riskabpmn:calculatedRisk xsi:type="xs:anyType"/>
      <riskabpmn:riskAcceptanceCriterion xsi:type="xs:anyType">1000</riskabpmn:riskAcceptanceCriterion>
    </bpmn2:extensionElements>
    <bpmn2:task id="Task_1" name="Task 1">
      <bpmn2:extensionElements>
        <riskabpmn:businessValue xsi:type="xs:anyType"/>
        <riskabpmn:reliabilityValue xsi:type="xs:anyType">0.9999</riskabpmn:reliabilityValue>
        <riskabpmn:calculatedRisk xsi:type="xs:anyType"/>
        <riskabpmn:probabilityValue xsi:type="xs:anyType">0.4</riskabpmn:probabilityValue>
      </bpmn2:extensionElements>
      <bpmn2:categoryValueRef>CategoryValue_2</bpmn2:categoryValueRef>
      <bpmn2:incoming>SequenceFlow_2</bpmn2:incoming>
      <bpmn2:incoming>SequenceFlow_4</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_10</bpmn2:outgoing>
    </bpmn2:task>
    <bpmn2:startEvent id="StartEvent_1" name="Start Event 1">
      <bpmn2:extensionElements>
        <riskabpmn:businessValue xsi:type="xs:anyType"/>
        <riskabpmn:reliabilityValue xsi:type="xs:anyType">1.0</riskabpmn:reliabilityValue>
        <riskabpmn:calculatedRisk xsi:type="xs:anyType"/>
      </bpmn2:extensionElements>
      <bpmn2:outgoing>SequenceFlow_2</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="EndEvent_1" name="End Event 1">
      <bpmn2:extensionElements>
        <riskabpmn:businessValue xsi:type="xs:anyType"/>
        <riskabpmn:reliabilityValue xsi:type="xs:anyType">1.0</riskabpmn:reliabilityValue>
        <riskabpmn:calculatedRisk xsi:type="xs:anyType"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>SequenceFlow_8</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_3" targetRef="EndEvent_1">
      <bpmn2:categoryValueRef>CategoryValue_2</bpmn2:categoryValueRef>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="SequenceFlow_10" sourceRef="Task_1" targetRef="ExclusiveGateway_3">
      <bpmn2:categoryValueRef>CategoryValue_2</bpmn2:categoryValueRef>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="SequenceFlow_2" sourceRef="StartEvent_1" targetRef="Task_1">
      <bpmn2:categoryValueRef>CategoryValue_2</bpmn2:categoryValueRef>
    </bpmn2:sequenceFlow>
    <bpmn2:exclusiveGateway id="ExclusiveGateway_3" name="Exclusive Gateway 1" gatewayDirection="Diverging">
      <bpmn2:extensionElements>
        <riskabpmn:businessValue xsi:type="xs:anyType"/>
        <riskabpmn:reliabilityValue xsi:type="xs:anyType">1.0</riskabpmn:reliabilityValue>
        <riskabpmn:calculatedRisk xsi:type="xs:anyType"/>
      </bpmn2:extensionElements>
      <bpmn2:categoryValueRef>CategoryValue_2</bpmn2:categoryValueRef>
      <bpmn2:incoming>SequenceFlow_10</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_8</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_4</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_3" targetRef="Task_1">
      <bpmn2:categoryValueRef>CategoryValue_2</bpmn2:categoryValueRef>
    </bpmn2:sequenceFlow>
    <bpmn2:group id="Group_3" categoryValueRef="CategoryValue_2"/>
  </bpmn2:process>
  <bpmn2:process id="Process_2" name="Non-initiating Process" definitionalCollaborationRef="Collaboration_1" isExecutable="false"/>
  <bpmn2:process id="Process_3" name="Default Pool Process" definitionalCollaborationRef="Collaboration_1" isExecutable="false"/>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1" name="Default Collaboration Diagram">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="BPMNShape_1" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds height="291.0" width="591.0" x="100.0" y="100.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_1" labelStyle="BPMNLabelStyle_1">
          <dc:Bounds height="74.0" width="15.0" x="106.0" y="208.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_2" bpmnElement="Participant_2" isHorizontal="true">
        <dc:Bounds height="150.0" width="591.0" x="100.0" y="474.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_2" labelStyle="BPMNLabelStyle_1">
          <dc:Bounds height="101.0" width="15.0" x="106.0" y="498.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Task_1" bpmnElement="Task_1" isExpanded="true">
        <dc:Bounds height="50.0" width="110.0" x="247.0" y="213.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_3" labelStyle="BPMNLabelStyle_1">
          <dc:Bounds height="15.0" width="37.0" x="283.0" y="230.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds height="36.0" width="36.0" x="151.0" y="220.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_6" labelStyle="BPMNLabelStyle_1">
          <dc:Bounds height="15.0" width="68.0" x="135.0" y="256.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds height="36.0" width="36.0" x="590.0" y="220.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_8" labelStyle="BPMNLabelStyle_1">
          <dc:Bounds height="15.0" width="65.0" x="576.0" y="256.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Group_3" bpmnElement="Group_3">
        <dc:Bounds height="132.0" width="357.0" x="210.0" y="190.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_10">
          <dc:Bounds height="15.0" width="90.0" x="343.0" y="193.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_ExclusiveGateway_3" bpmnElement="ExclusiveGateway_3" isMarkerVisible="true">
        <dc:Bounds height="50.0" width="50.0" x="482.0" y="213.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_26" labelStyle="BPMNLabelStyle_1">
          <dc:Bounds height="30.0" width="57.0" x="479.0" y="263.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_SequenceFlow_8" bpmnElement="SequenceFlow_8" sourceElement="BPMNShape_ExclusiveGateway_3" targetElement="BPMNShape_EndEvent_1">
        <di:waypoint xsi:type="dc:Point" x="532.0" y="238.0"/>
        <di:waypoint xsi:type="dc:Point" x="561.0" y="238.0"/>
        <di:waypoint xsi:type="dc:Point" x="590.0" y="238.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_16"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SequenceFlow_10" bpmnElement="SequenceFlow_10" sourceElement="BPMNShape_Task_1" targetElement="BPMNShape_ExclusiveGateway_3">
        <di:waypoint xsi:type="dc:Point" x="357.0" y="238.0"/>
        <di:waypoint xsi:type="dc:Point" x="419.0" y="238.0"/>
        <di:waypoint xsi:type="dc:Point" x="482.0" y="238.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SequenceFlow_2" bpmnElement="SequenceFlow_2" sourceElement="BPMNShape_StartEvent_1" targetElement="BPMNShape_Task_1">
        <di:waypoint xsi:type="dc:Point" x="187.0" y="238.0"/>
        <di:waypoint xsi:type="dc:Point" x="217.0" y="238.0"/>
        <di:waypoint xsi:type="dc:Point" x="247.0" y="238.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_25"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_SequenceFlow_4" bpmnElement="SequenceFlow_4" sourceElement="BPMNShape_ExclusiveGateway_3" targetElement="BPMNShape_Task_1">
        <di:waypoint xsi:type="dc:Point" x="507.0" y="263.0"/>
        <di:waypoint xsi:type="dc:Point" x="507.0" y="307.0"/>
        <di:waypoint xsi:type="dc:Point" x="302.0" y="307.0"/>
        <di:waypoint xsi:type="dc:Point" x="302.0" y="263.0"/>
        <bpmndi:BPMNLabel id="BPMNLabel_27"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
    <bpmndi:BPMNLabelStyle id="BPMNLabelStyle_1">
      <dc:Font name="arial" size="9.0"/>
    </bpmndi:BPMNLabelStyle>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>